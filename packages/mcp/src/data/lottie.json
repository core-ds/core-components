      "title": "Lottie",
      "description": "",
      "desktop": "render(() => {\nconst [play, setPlay] = React.useState(true);\nconst { direction, onIterationChange } = useBounce(1);\nconst handleTooglePlay = () => {\nsetPlay((p) => !p);\n};\n\nreturn (\n<div>\n<Button onClick={handleTooglePlay}>{play ? 'Pause' : 'Play'}</Button>\n<Lottie\nonPlayChange={setPlay}\nplay={play}\ndirection={direction}\nspeed={1}\niterations={4}\nsrc='./lottie/twitter-heart.json'\nsize={{ width: 400, height: 400 }}\nonIterationChange={onIterationChange}\n/>\n</div>\n);\n});"
    }
