{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "@alfalab/core-components-env/tsconfig.base.json",
    "include": ["src", "src/**/*.json"],
    "exclude": ["**/*.stories.*", "**/*.test.*"],
    "compilerOptions": {
        "rootDir": "src",
        "outDir": "ts-dist",
        "paths": {
            "@alfalab/core-components-animation-private": ["../animation-private/src"],
            "@alfalab/core-components-animation-private/*": ["../animation-private/src/*"],
            "@alfalab/core-components-collapse": ["./src"],
            "@alfalab/core-components-collapse/*": ["./src/*"],
            "@alfalab/core-components-link": ["../link/src"],
            "@alfalab/core-components-link/*": ["../link/src/*"]
        }
    },
    "references": [
        { "path": "../animation-private/tsconfig.build.json" },
        { "path": "../link/tsconfig.build.json" }
    ]
}
